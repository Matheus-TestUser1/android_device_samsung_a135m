on init
    # Verifica qual sistema USB usar
    write /sys/class/android_usb/android0/enable 0
    setprop sys.usb.android_old 0
    
    # Tenta acessar o sistema legado para verificar se está disponível
    if [ -e /sys/class/android_usb/android0/functions ]
    then
        setprop sys.usb.android_old 1
    fi

    # Sempre configura ConfigFS (para dispositivos modernos)
    mount configfs none /config
    mkdir /config/usb_gadget/g1 0770 shell shell
    mkdir /config/usb_gadget/g1/strings/0x409 0770
    mkdir /config/usb_gadget/g1/configs/b.1 0777 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770

    write /config/usb_gadget/g1/idVendor 0x04E8     # Samsung vendor ID
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer "SAMSUNG"
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    write /config/usb_gadget/g1/configs/b.1/MaxPower 900

    # Funções USB essenciais
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    mkdir /config/usb_gadget/g1/functions/ffs.fastboot
    mkdir /config/usb_gadget/g1/functions/ffs.sideload
    mkdir /config/usb_gadget/g1/functions/ss_mon.mtp

    # Se sistema legado estiver disponível, também configura ele
    if [ "$(getprop sys.usb.android_old)" = "1" ]
    then
        write /sys/class/android_usb/android0/idVendor 0x04E8
        write /sys/class/android_usb/android0/f_ffs/aliases adb
        write /sys/class/android_usb/android0/iManufacturer "SAMSUNG"
        write /sys/class/android_usb/android0/iProduct ${ro.product.model}
        write /sys/class/android_usb/android0/iSerial ${ro.serialno}
    fi

on fs
    mount pstore pstore /sys/fs/pstore
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mkdir /dev/usb-ffs/mtp 0770 mtp mtp
    mkdir /dev/usb-ffs/fastboot 0770 system system
    mkdir /dev/usb-ffs/sideload 0770 shell shell
    
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    mount functionfs mtp /dev/usb-ffs/mtp uid=2000,gid=2000
    mount functionfs fastboot /dev/usb-ffs/fastboot uid=1000,gid=1000
    mount functionfs sideload /dev/usb-ffs/sideload uid=2000,gid=2000

    setprop sys.usb.configfs 1

on property:sys.usb.config=none
    stop adbd
    stop fastbootd
    setprop sys.usb.ffs.ready 0
    
    # Desliga ConfigFS
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    rm /config/usb_gadget/g1/configs/b.1/f3
    write /config/usb_gadget/g1/bDeviceClass 0
    write /config/usb_gadget/g1/bDeviceSubClass 0
    write /config/usb_gadget/g1/bDeviceProtocol 0
    
    # Desliga sistema legado se estiver disponível
    if [ "$(getprop sys.usb.android_old)" = "1" ]
    then
        write /sys/class/android_usb/android0/enable 0
    fi
    
    setprop sys.usb.state ${sys.usb.config}

# ADB modo
on property:sys.usb.config=adb
    start adbd

on property:sys.usb.ffs.ready=1 && property:sys.usb.config=adb
    # Determina qual sistema usar com base na disponibilidade
    # Se android_old=1, usamos o sistema legado, caso contrário, o ConfigFS
    
    if [ "$(getprop sys.usb.android_old)" = "1" ]
    then
        # Configuração para sistema legado
        write /sys/class/android_usb/android0/enable 0
        write /sys/class/android_usb/android0/idVendor 0x04E8
        write /sys/class/android_usb/android0/idProduct 0x6860
        write /sys/class/android_usb/android0/functions adb
        write /sys/class/android_usb/android0/enable 1
    else
        # Configuração para ConfigFS
        write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb"
        rm /config/usb_gadget/g1/configs/b.1/f1
        write /config/usb_gadget/g1/idProduct 0x6860
        symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
        write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    fi
    
    setprop sys.usb.state ${sys.usb.config}

# MTP+ADB modo
on property:sys.usb.config=mtp,adb
    start adbd

on property:sys.usb.ffs.ready=1 && property:sys.usb.config=mtp,adb
    if [ "$(getprop sys.usb.android_old)" = "1" ]
    then
        # Configuração para sistema legado
        write /sys/class/android_usb/android0/enable 0
        write /sys/class/android_usb/android0/idVendor 0x04E8
        write /sys/class/android_usb/android0/idProduct 0x6860
        write /sys/class/android_usb/android0/functions mtp,adb
        write /sys/class/android_usb/android0/enable 1
    else
        # Configuração para ConfigFS
        write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
        rm /config/usb_gadget/g1/configs/b.1/f1
        rm /config/usb_gadget/g1/configs/b.1/f2
        rm /config/usb_gadget/g1/configs/b.1/f3
        write /config/usb_gadget/g1/idProduct 0x6860
        symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
        symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
        symlink /config/usb_gadget/g1/functions/ss_mon.mtp /config/usb_gadget/g1/configs/b.1/f3
        write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    fi
    
    setprop sys.usb.state ${sys.usb.config}

# Fastboot
on property:sys.usb.config=fastboot
    stop adbd
    start fastbootd

on property:sys.usb.ffs.ready=1 && property:sys.usb.config=fastboot
    if [ "$(getprop sys.usb.android_old)" = "1" ]
    then
        # Configuração para sistema legado
        write /sys/class/android_usb/android0/enable 0
        write /sys/class/android_usb/android0/idVendor 0x04E8
        write /sys/class/android_usb/android0/idProduct 0x4EE0
        write /sys/class/android_usb/android0/functions fastboot
        write /sys/class/android_usb/android0/enable 1
    else
        # Configuração para ConfigFS
        write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "fastboot"
        rm /config/usb_gadget/g1/configs/b.1/f1
        write /config/usb_gadget/g1/idProduct 0x4EE0
        symlink /config/usb_gadget/g1/functions/ffs.fastboot /config/usb_gadget/g1/configs/b.1/f1
        write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    fi
    
    setprop sys.usb.state ${sys.usb.config}

# Sideload
on property:sys.usb.config=sideload
    start adbd

on property:sys.usb.ffs.ready=1 && property:sys.usb.config=sideload
    if [ "$(getprop sys.usb.android_old)" = "1" ]
    then
        # Configuração para sistema legado
        write /sys/class/android_usb/android0/enable 0
        write /sys/class/android_usb/android0/idVendor 0x04E8
        write /sys/class/android_usb/android0/idProduct 0xD001
        write /sys/class/android_usb/android0/functions sideload
        write /sys/class/android_usb/android0/enable 1
    else
        # Configuração para ConfigFS
        write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "sideload"
        rm /config/usb_gadget/g1/configs/b.1/f1
        write /config/usb_gadget/g1/idProduct 0xD001
        symlink /config/usb_gadget/g1/functions/ffs.sideload /config/usb_gadget/g1/configs/b.1/f1
        write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    fi
    
    setprop sys.usb.state ${sys.usb.config}
