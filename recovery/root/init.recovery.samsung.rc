on init
    # Remover e recriar diretórios necessários
    rm /efs
    mkdir /efs
    mkdir /sec_efs

on fs
    # Garantir que o diretório efs esteja montado (se necessário)
    mkdir /mnt/vendor/efs 0771 radio system
    mount ext4 /dev/block/by-name/efs /efs
    mount ext4 /dev/block/by-name/efs /mnt/vendor/efs

on post-fs
    # Permissões importantes para nós de dispositivo do touchscreen
    chmod 0660 /dev/tspio
    chmod 0660 /dev/tsp_data
    chmod 0660 /sys/class/sec/tsp/cmd
    chmod 0666 /dev/input/event3  # sec_touchscreen

    # Definir permissões antes do serviço iniciar
    chown system system /dev/tspio
    chown system system /dev/tsp_data
    chown system system /sys/class/sec/tsp/input/enabled
    chown system system /sys/class/sec/tsp/enabled
    chown system system /dev/input/event3

on early-boot
    # Reset inicial do touchscreen
    write /sys/class/sec/tsp/reset 1
    sleep 2
    
    # Habilitar touchscreen
    write /sys/class/sec/tsp/enabled 1
    write /sys/class/sec/tsp/input/enabled 1
    
    # Iniciar serviços necessários antes do sysinput
    start hwservicemanager
    start vendor.keymaster-4-0
    start servicemanager
    sleep 1
    
    # Forçar inicialização do touch
    write /sys/class/sec/tsp/cmd "force_touch_active"
    write /sys/class/sec/tsp/cmd "set_lowpower_mode:0"
    sleep 1

# Define serviços necessários
service hwservicemanager /system/bin/hwservicemanager
    user root
    group root readproc
    seclabel u:r:recovery:s0
    onrestart setprop hwservicemanager.ready false
    disabled
    oneshot

service servicemanager /system/bin/servicemanager
    user root
    group root readproc
    seclabel u:r:recovery:s0
    disabled
    oneshot

service vendor.keymaster-4-0 /vendor/bin/hw/android.hardware.keymaster@4.0-service
    user root
    group root
    seclabel u:r:recovery:s0
    disabled
    oneshot

service sec-sysinput-aidl /vendor/bin/hw/vendor.samsung.hardware.sysinput-service
    class hal
    priority -8
    user system
    group system input
    seclabel u:r:recovery:s0
    disabled
    oneshot

on property:sys.boot_completed=1
    # Re-aplicar permissões importantes do touch
    chown system system /dev/tspio
    chown system system /sys/class/sec/tsp/input/enabled
    chown system system /sys/class/sec/tsp/enabled
    
    # Re-ativar touch
    write /sys/class/sec/tsp/reset 1
    sleep 1
    write /sys/class/sec/tsp/enabled 1
    write /sys/class/sec/tsp/input/enabled 1

on boot
    # Garantir permissões novamente
    chmod 0666 /dev/input/event3
    
    # Forçar um evento para "acordar" o touchscreen
    input tap 100 100
