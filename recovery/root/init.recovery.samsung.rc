# TWRP init.recovery.samsung.rc for Samsung Galaxy A13
# Updated: 2025-03-13 14:11:07
# Author: Matheus-TestUser1

on init
    rm /efs
    mkdir /efs
    mkdir /sec_efs

on fs
    mkdir /mnt/vendor/efs 0771 radio system
    wait /dev/block/by-name/efs
    mount ext4 /dev/block/by-name/efs /efs
    mount ext4 /dev/block/by-name/efs /mnt/vendor/efs

    # TAAS directories
    mkdir /efs/taas 0775 system system
    mkdir /mnt/vendor/efs/taas 0775 system system

on post-fs
    wait /dev/input/event3
    chmod 0666 /dev/input/event3
    chmod 0666 /dev/input*
    
    # Touch nodes permissions
    chmod 0666 /sys/class/sec*
    chmod 0666 /sys/class/sec/tsp*
    chmod 0660 /sys/class/sec/tsp/cmd
    chmod 0660 /sys/class/sec/tsp/input/enabled
    chmod 0660 /sys/class/sec/tsp/enabled

    # Touch features permissions
    chown system system /sys/class/sec/tsp*
    chown system system /sys/class/sec*
    chown system system /sys/class/sec/tsp/multi_count
    chown system system /sys/class/sec/tsp/wet_mode
    chown system system /sys/class/sec/tsp/noise_mode
    chown system system /sys/class/sec/tsp/comm_err_count
    chown system system /sys/class/sec/tsp/checksum
    chown system system /sys/class/sec/tsp/all_touch_count
    chown system system /sys/class/sec/tsp/sensitivity_mode

on early-boot
    write /sys/class/sec/tsp/reset 1
    exec_background - system system -- /system/bin/sleep 3
    
    # Enable all touch inputs
    write /sys/class/sec/tsp/enabled 1
    write /sys/class/sec/tsp/input/enabled 1
    write /sys/class/sec/tsp1/enabled 1
    write /sys/class/sec/tsp1/input/enabled 1
    write /sys/class/sec/tsp2/enabled 1
    write /sys/class/sec/tsp2/input/enabled 1
    
    start hwservicemanager
    start vendor.keymaster-4-0
    start servicemanager
    exec_background - system system -- /system/bin/sleep 2
    
    write /sys/class/sec/tsp/cmd "force_touch_active"
    write /sys/class/sec/tsp/cmd "set_lowpower_mode:0"


# Serviços
service hwservicemanager /system/bin/hwservicemanager
    user root
    group root readproc
    seclabel u:r:recovery:s0
    onrestart setprop hwservicemanager.ready false
    disabled
    oneshot

service servicemanager /system/bin/servicemanager
    user root
    group root readproc
    seclabel u:r:recovery:s0
    disabled
    oneshot

service vendor.keymaster-4-0 /vendor/bin/hw/android.hardware.keymaster@4.0-service
    user root
    group root
    seclabel u:r:recovery:s0
    socket keymaster-4-0 stream 0666 root root
    disabled
    oneshot

service sec-sysinput-aidl /vendor/bin/hw/vendor.samsung.hardware.sysinput-service
    class hal
    priority -8
    user system
    group system input
    seclabel u:r:recovery:s0
    disabled
    oneshot

on property:sys.boot_completed=1
    # Reapply all touch permissions
    chown system system /dev/tspio
    chown system system /dev/tsp_data
    chown system system /sys/class/sec/tsp/input/enabled
    chown system system /sys/class/sec/tsp1/input/enabled
    chown system system /sys/class/sec/tsp2/input/enabled
    chown system system /sys/class/sec/sec_epen/input/enabled
    chown system system /sys/class/sec/tsp/enabled
    chown system system /sys/class/sec/tsp1/enabled
    chown system system /sys/class/sec/tsp2/enabled

    # Re-enable all touch inputs
    write /sys/class/sec/tsp/reset 1
    exec_background - system system -- /system/bin/sleep 2
    write /sys/class/sec/tsp/enabled 1
    write /sys/class/sec/tsp/input/enabled 1
    write /sys/class/sec/tsp1/enabled 1
    write /sys/class/sec/tsp1/input/enabled 1
    write /sys/class/sec/tsp2/enabled 1
    write /sys/class/sec/tsp2/input/enabled 1
